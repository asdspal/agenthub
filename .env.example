# AgentHub — environment template (stage 2)
# Copy to `.env.local` for local development; set the same keys in the Vercel
# project's Production environment. Never commit a real value.
#
# Rules enforced by the pipeline verifiers and by T-006:
#   * only `NEXT_PUBLIC_*` values reach the browser bundle; the App Key is the
#     documented browser-safe app identifier, everything else stays server-side;
#   * no secret (App Secret, ingest key, store token) may appear in a
#     `NEXT_PUBLIC_*` variable;
#   * values in angle brackets are placeholders, not secrets.

# ---------------------------------------------------------------- Nexconn SDK
# App Key: the documented browser-safe app identifier. Required server-side for
# backend SDK init, and mirrored into the public variable below for the browser
# bootstrap (NCEngine.initialize({appKey})).
NEXCONN_APP_KEY=<from-nexconn-console>

# Same value as NEXCONN_APP_KEY, exposed to the browser at build time. This is
# the ONLY permitted NEXT_PUBLIC_* Nexconn value (R-006).
NEXT_PUBLIC_NEXCONN_APP_KEY=<from-nexconn-console>

# App Secret. Secret: server-side only, used solely to mint per-user Nexconn
# tokens for Server API calls. Never in a client bundle, never in the repo.
NEXCONN_API_SECRET=<from-nexconn-console>

# ---------------------------------------------------------------- Agent auth
# Shared bearer secret for the agent-facing write endpoints
# (POST /api/findings, POST /api/findings/{id}/replies). Secret: rotate once
# before submission; the demo scripts read it from this file only.
AGENTHUB_INGEST_KEY=<generate-openssl-rand-hex-32>

# ---------------------------------------------------------------- Tier-2 store
# Operational store switch. `true` enables the libSQL/Turso projections and the
# shared rate-limit counters (srd.md §4, ADR SD-2). `false` runs pure-Nexconn:
# the dedup/replay window is read from Nexconn history, rate caps become
# per-instance, and the audit trail is stdout only.
STORE_ENABLED=true

# libSQL/Turso endpoint (libsql://<db>-<org>.turso.io) and auth token. Secret:
# server-side only; the store is a projection of Nexconn state, never the
# system of record.
TURSO_DATABASE_URL=<libsql-url-from-turso-console>
TURSO_AUTH_TOKEN=<from-turso-console>

# ---------------------------------------------------------------- Dedup matcher
# Keyword-overlap dedup (blueprint D-006). `DEDUP_ENABLED=false` is an
# emergency abuse kill-switch only: with it off T-013(b) fails, so it is never
# a demo fallback.
DEDUP_ENABLED=true
# Jaccard threshold over normalized title+body tokens (spike-calibrated).
DEDUP_THRESHOLD=0.45
# Bonus added when both findings name the same version.
DEDUP_VERSION_BONUS=0.10
# Size of the per-room dedup/replay window (top-level findings).
DEDUP_WINDOW_SIZE=50

# ---------------------------------------------------------------- UI
# `true` renders finding cards in the application-built panel fed by SDK
# messages (D-011 fallback) instead of the ChatUI custom renderer. Both paths
# satisfy R-007.
CHATUI_FALLBACK_PANEL=false

# ---------------------------------------------------------------- Rate limits
# Per-agent and per-IP ingestion caps, and the token-broker cap (requests per
# minute). Enforced through rate_limit_counter when STORE_ENABLED=true.
RATE_LIMIT_INGEST_PER_AGENT=30
RATE_LIMIT_INGEST_PER_IP=60
RATE_LIMIT_MINT_PER_IP=20

# ---------------------------------------------------------------- Operations
# Audit sink: `stdout` emits one JSON line per audited event (always on) and
# `store` additionally appends to audit_event. Use `both` for the recorded demo.
AUDIT_LOG_SINK=both
# `debug` | `info` | `warn` | `error`.
LOG_LEVEL=info

# Public base URL of the deployment; used in the landing page copy and the
# operator runbook.
NEXT_PUBLIC_APP_URL=https://agenthub.vercel.app

# The single demo supervisor identity the token broker will mint for (R-011).
DEMO_SUPERVISOR_ID=supervisor-demo

# Timeout for the GET /api/health dependency probe, in milliseconds.
HEALTH_PROBE_TIMEOUT_MS=2000
